# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Help Desk email via Resend (optional — requests still save to Supabase without these)
# Create key: https://resend.com/api-keys
RESEND_API_KEY=
# Must use an address on a domain verified in Resend (not necessarily your inbox address)
SUPPORT_FROM_EMAIL=RevueSuite <support@revuesuite.com>
# Where team notifications go (defaults to admin@revuesuite.com if unset)
# SUPPORT_INBOX_EMAIL=admin@revuesuite.com
